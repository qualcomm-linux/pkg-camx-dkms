PACKAGE_NAME="camx"
PACKAGE_VERSION="#MODULE_VERSION#"

# Update SUPPORTED_TARGETS when adding or removing a camera target
SUPPORTED_TARGETS="qcm6490 qcs9100 qcs615 x1e80100"

# dkms only injects -j${parallel_jobs} into MAKE lines starting with "make";
# so pass parallel_jobs to dkms-build explicitly
MAKE="PARALLEL_JOBS='${parallel_jobs}' ./dkms-build ${kernelver} ${dkms_tree} ${PACKAGE_NAME} ${PACKAGE_VERSION}"
CLEAN="./dkms-clean ${kernelver} ${dkms_tree} ${PACKAGE_NAME} ${PACKAGE_VERSION}"
AUTOINSTALL="yes"

BUILD_EXCLUSIVE_CONFIG="CONFIG_ARCH_QCOM"
BUILD_EXCLUSIVE_KERNEL_MIN="6.16"
